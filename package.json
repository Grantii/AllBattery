{
  "name": "allbattery",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "AllBattery - Home-Assistant-Dashboard zur Ueberwachung aller Batterie- und Akkuzustaende",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "build:panel": "tsc --noEmit && vite build --config vite.config.panel.ts",
    "build:all": "npm run build && npm run build:panel",
    "deploy:ha": "npm run build && node scripts/deploy-to-ha.mjs"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}
